# Copy to .env.local to override. All variables are optional.

# Base URL of the ranking / match history API (served by MSW in every build).
VITE_API_BASE_URL=/api

# Axios request timeout in milliseconds (the ?apiTimeout=<ms> URL parameter overrides it).
VITE_API_TIMEOUT_MS=4000

# Set to "false" to not start the MSW service worker (e.g. when pointing at a real API).
VITE_ENABLE_MOCKS=true
